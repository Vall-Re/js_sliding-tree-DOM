        var ulIndex = nodes.indexOf(childUl);
        var textNode = nodes.find(function(n, i) {
            return n.nodeType === Node.TEXT_NODE && n.textContent.trim() && i < ulIndex;
        });
        if (!textNode) return;
        var span = document.createElement("span");
        span.textContent = textNode.textContent;
        li.replaceChild(span, textNode);
        var initialDisplay = getComputedStyle(childUl).display;
        span.addEventListener("click", function(e) {
